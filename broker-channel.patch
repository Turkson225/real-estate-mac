+import { createFileRoute, Link } from "@tanstack/react-router";
+import { BROKER_ADDRESS, BROKER_NAME } from "@/lib/marketplace";
+
+export const Route = createFileRoute("/broker/$address")({
+  head: () => ({
+    meta: [
+      { title: "Broker channel — ApexAnchor" },
+      { name: "description", content: "Contact the ApexAnchor broker privately about buying or selling." },
+      { property: "og:title", content: "Broker channel — ApexAnchor" },
+      { property: "og:description", content: "A private channel for buyers, sellers and the ApexAnchor broker." },
+      { property: "og:type", content: "website" },
+      { name: "twitter:card", content: "summary" },
+    ],
+  }),
+  component: BrokerProfile,
+});
+
+function BrokerProfile() {
+  const { address } = Route.useParams();
+  const isKnownBroker = address.toLowerCase() === BROKER_ADDRESS;
+
+  if (!isKnownBroker) {
+    return (
+      <div className="max-w-xl mx-auto px-5 py-20 text-center">
+        <h1 className="font-editorial text-4xl">Broker address not found</h1>
+        <p className="text-muted-foreground mt-3">Check the address and try again.</p>
+        <Link to="/" className="btn-outline mt-6 inline-flex">Return home</Link>
+      </div>
+    );
+  }
+
+  return (
+    <div className="max-w-3xl mx-auto px-5 py-16">
+      <div className="card-warm p-8 md:p-12">
+        <p className="text-xs uppercase tracking-[0.2em] text-primary">Verified broker channel</p>
+        <h1 className="font-editorial text-5xl mt-3">Work with {BROKER_NAME}</h1>
+        <p className="text-lg text-muted-foreground mt-4 max-w-xl">
+          Every offer, question and selling request is handled privately by the broker before it moves forward.
+        </p>
+
+        <div className="mt-8 border-y border-border/70 py-5">
+          <p className="text-xs uppercase tracking-widest text-muted-foreground">Unique broker address</p>
+          <p className="font-editorial text-3xl mt-1">@{BROKER_ADDRESS}</p>
+          <p className="text-sm text-muted-foreground mt-2">Use this address when referring someone to the official ApexAnchor broker.</p>
+        </div>
+
+        <div className="mt-8 grid sm:grid-cols-3 gap-3">
+          <Link to="/browse" search={{ kind: "sale" }} className="btn-primary text-center">Buy an asset</Link>
+          <Link to="/sell" className="btn-outline text-center">Sell an asset</Link>
+          <Link to="/auth" className="btn-ghost text-center">Sign in</Link>
+        </div>
+
+        <p className="text-sm text-muted-foreground mt-6">
+          Buyers start a private thread from a listing. Sellers start one automatically when they submit an asset.
+        </p>
+      </div>
+    </div>
+  );
+}
